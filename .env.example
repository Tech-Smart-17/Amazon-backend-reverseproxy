# Application Configuration
APP_NAME="Amazon Backend System"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=supersecretjwtkeyforamazonbackendenterprise2026productionuseonly!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# SQL Database Configuration (SQLite default for out-of-the-box running, PostgreSQL supported)
DATABASE_URL=sqlite+aiosqlite:///./amazon_backend.db
# POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/amazon_db

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=amazon_mongo_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# ChromaDB Vector Store Directory
CHROMADB_DIR=./uploads/chromadb_store

# Optional LangChain features (the local embedding model downloads on first use)
LANGCHAIN_CHAT_MODEL=google_genai:gemini-3.7-flash
LANGCHAIN_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LANGCHAIN_CHUNK_SIZE=800
LANGCHAIN_CHUNK_OVERLAP=120
KNOWLEDGE_UPLOAD_MAX_BYTES=20000000
